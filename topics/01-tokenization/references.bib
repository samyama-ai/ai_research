@inproceedings{arnett2025inequities,
  title     = {Explaining and Mitigating Crosslingual Tokenizer Inequities},
  author    = {Arnett, Catherine and Chang, Tyler A. and Biderman, Stella and Bergen, Benjamin K.},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  year      = {2025},
  eprint    = {2510.21909},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2510.21909},
  annote    = {GATING PAPER. Trains ~7,000 monolingual tokenizers over 97 languages; maps how token-premium disparity varies with vocab size + pre-tokenizer. Gates our H1 (parity-is-budget-governed) to RED. BUT uses PER-LANGUAGE vocab sizes, not a fixed JOINT budget, and no script-disjoint/merge-reclamation -> leaves the joint-budget min-max-gap regime (our H4 angle) open/YELLOW.}
